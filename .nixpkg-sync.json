{
  "kind": "github-release",
  "upstream": "storytold/photocraft",
  "tag_regex": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "tag_prefix": "v",
  "version_file": "nix/package-manifest.json",
  "version_jq": ".package.version",
  "pinned_paths": [
    "nix/package-manifest.json"
  ],
  "sync_script": "bash \"$NIXPKG_CI_DIR/sync-github-release.sh\""
}
